#!/usr/bin/env bash
set -euo pipefail

case "${1:-}" in
  list)
    printf '%s' "${S_TEST_LIST_OUTPUT:-}"
    ;;
  hardcopy)
    printf '%s' "${S_TEST_HARDCOPY_OUTPUT:-}"
    printf '%s\n' "$*" > "${S_TEST_LOG:?}"
    ;;
  attach)
    printf '%s\n' "$*" > "${S_TEST_LOG:?}"
    exit "${S_TEST_ATTACH_STATUS:-0}"
    ;;
  *)
    echo "unexpected shpool command: $*" >&2
    exit 2
    ;;
esac
